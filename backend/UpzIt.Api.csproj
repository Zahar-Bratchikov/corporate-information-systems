<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>UpzIt.Api</RootNamespace>
    <AssemblyName>UpzIt.Api</AssemblyName>
  </PropertyGroup>

  <!-- Тестовый проект лежит в подпапке; SDK по умолчанию включает все **/*.cs и тащит тесты в сборку API. -->
  <ItemGroup>
    <Compile Remove="UpzIt.Api.Tests/**" />
    <Content Remove="UpzIt.Api.Tests/**" />
    <EmbeddedResource Remove="UpzIt.Api.Tests/**" />
    <None Remove="UpzIt.Api.Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.11" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.2.0" />
    <PackageReference Include="QuestPDF" Version="2024.10.2" />
  </ItemGroup>

</Project>
